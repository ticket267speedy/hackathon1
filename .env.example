# Copiar a .env y rellenar
SERVER_PORT=8082
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dbf_hackathon
DB_USERNAME=postgres
DB_PASSWORD=postgres

# >= 32 bytes obligatorio
JWT_SECRET=change-me-in-production-this-is-a-very-long-secret-key-please

# Mailtrap / SMTP (autotests levantan mock en 2525 si está vacío)
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tuckersoft.com

SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=admin123
SEED_ADMIN_EMAIL=admin@tuckersoft.com
SEED_USER_USER=user
SEED_USER_PASS=user123
SEED_USER_EMAIL=user@tuckersoft.com
